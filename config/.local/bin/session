#!/usr/bin/env bash

dirs=( 
    "$HOME" 
    "$HOME/.config"
    "$HOME/projects"
)
for dir in "${dirs[@]}"; do
    if [[ ! -d "$dir" ]]; then
        echo "$dir doesn't exist"
        exit 1
    fi
done

path="$( find -L "${dirs[@]}" -maxdepth 2 -type d -not -name ".*" | fzf-tmux )"
if [[ -z "$path" ]]; then
    exit 0
fi
name="$( basename "$path" )"

if ! tmux has-session -t "$name" 2>/dev/null; then
    tmux new -s "$name" -n 'shell' -c "$path" -d
fi

if [[ -z "$TMUX" ]]; then
    tmux attach -t "$name"
else
    tmux switch-client -t "$name"
fi
