# This goes to .bashrc
# if [ -f ~/.bash_custom ]; then
#     . ~/.bash_custom
# fi

# Disable XON/XOFF control flow so readline
# forward and backward search works correctly
stty -ixon

PS1='\[\e[32m\]\w\[\e[0m\]\$ '

export EDITOR='nvim'

alias ll='ls -lh --color=auto'
alias la='ls -lah --color=auto'

alias lg='lazygit'

up() {
    [[ $1 =~ ^\.+$ ]] && cd "${1//./../}" || echo 'invalid format'
}

bak() {
    [[ "$1" ]] && cp -r "$1" "$1.bak" || echo 'no file specified'
}

tohex() {
    if [[ -z "$1" ]]; then
        echo 'no number specified\n'
        exit 1
    fi
    result="$(bc <<< "obase=16;${1}")"
    echo "0x${result,,}"
}

todec() {
    if [[ -z "$1" ]]; then
        echo 'no number specified\n'
        exit 1
    fi

    n="$1"

    if [[ "$n" =~ ^0x([0-9A-Fa-f]+)$ ]]; then
        n="${BASH_REMATCH[1]}"
    fi

    bc <<< "ibase=16;${n^^}"
}
